        /* ═══════════════════════════════════════ */
        footer {
            background: var(--bg-dark);
            color: var(--text-white);
            padding: 60px 40px 40px;
            text-align: center;
        }

        .footer-quote {
            font-family: 'Lora', serif;
            font-size: 22px;
            font-style: italic;
            font-weight: 400;
            margin-bottom: 32px;
