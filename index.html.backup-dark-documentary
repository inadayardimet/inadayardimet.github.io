    // ═══════════════════════════════════════════════════════════
    // 🌐 LANGUAGE SWITCHER
    // ═══════════════════════════════════════════════════════════
    let currentLang = 'az';

    function setLanguage(lang) {
        if (!TRANSLATIONS[lang]) return;
        currentLang = lang;
        document.documentElement.lang = lang;
        const t = TRANSLATIONS[lang];

        // Update all data-i18n elements
        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (t[key] !== undefined) {
                if (key === 'storyHtml') {
                    el.innerHTML = t[key];
                } else {
                    el.textContent = t[key];
                }
            }
        });

        // Story has multiple paragraphs — use innerHTML
        const storyEl = document.getElementById('storyText');
        if (storyEl && t.storyHtml) {
            storyEl.innerHTML = t.storyHtml;
        }

        // Active button state
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.lang === lang);
        });

        // Update share button URLs
        updateShareLinks();

        // Save preference
        try { localStorage.setItem('inad-lang', lang); } catch (e) {}
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => setLanguage(btn.dataset.lang));
    });

    // ═══════════════════════════════════════════════════════════
    // 📋 COPY TO CLIPBOARD + TOAST + META PIXEL
    // ═══════════════════════════════════════════════════════════
    function showToast(message, isError = false) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.style.background = isError ? '#C62828' : '#2E7D32';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2400);
    }

    document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const cardNum = btn.dataset.card;
            const t = TRANSLATIONS[currentLang];

            try {
                await navigator.clipboard.writeText(cardNum);

                // Visual feedback
                const original = btn.textContent;
                btn.textContent = '✓ ' + (currentLang === 'az' ? 'Kopyalandı' : currentLang === 'ru' ? 'Скопировано' : 'Copied');
                btn.classList.add('copied');

                setTimeout(() => {
                    btn.textContent = t.copyBtn;
                    btn.classList.remove('copied');
                }, 2000);

                showToast(t.toastCopied);

                // Meta Pixel AddToCart event
                if (typeof fbq !== 'undefined') {
                    fbq('track', 'AddToCart', {
                        content_name: 'Bank Card Copy',
                        content_category: 'Donation',
                        content_ids: [cardNum.substring(0, 4)],
                        value: 0,
                        currency: 'USD'
                    });
                }
            } catch (err) {
                // Fallback for older browsers
                try {
                    const ta = document.createElement('textarea');
                    ta.value = cardNum;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    showToast(t.toastCopied);
                } catch (e2) {
                    showToast(t.toastCopyError, true);
                }
            }
        });
    });

    // ═══════════════════════════════════════════════════════════
    // 🖼️ LIGHTBOX (gallery + documents)
    // ═══════════════════════════════════════════════════════════
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxClose = document.querySelector('.lightbox-close');
    const lightboxPrev = document.querySelector('.lightbox-prev');
    const lightboxNext = document.querySelector('.lightbox-next');

    let lightboxImages = [];
    let lightboxIndex = 0;

    function openLightbox(images, index) {
        lightboxImages = images;
        lightboxIndex = index;
        lightboxImg.src = images[index];
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
    }

    function navLightbox(dir) {
        lightboxIndex = (lightboxIndex + dir + lightboxImages.length) % lightboxImages.length;
        lightboxImg.src = lightboxImages[lightboxIndex];
    }

    // Gallery items
    const galleryImages = Array.from(document.querySelectorAll('.gallery-item')).map(el => el.dataset.img);
    document.querySelectorAll('.gallery-item').forEach((el, i) => {
        el.addEventListener('click', () => openLightbox(galleryImages, i));
    });

    // Document items
    const docImages = Array.from(document.querySelectorAll('.doc-card')).map(el => el.dataset.img);
    document.querySelectorAll('.doc-card').forEach((el, i) => {
        el.addEventListener('click', () => openLightbox(docImages, i));
    });

    lightboxClose.addEventListener('click', closeLightbox);
    lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); navLightbox(-1); });
    lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); navLightbox(1); });
    lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
    });
    lightboxImg.addEventListener('click', (e) => e.stopPropagation());

    document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navLightbox(-1);
        if (e.key === 'ArrowRight') navLightbox(1);
    });

    // ═══════════════════════════════════════════════════════════
    // 🔗 SHARE BUTTONS
    // ═══════════════════════════════════════════════════════════
    function updateShareLinks() {
        const url = window.location.href;
        const t = TRANSLATIONS[currentLang];
        const text = t.shareText;

        document.getElementById('shareWhatsApp').href =
            `https://wa.me/?text=${encodeURIComponent(text + ' — ' + url)}`;
        document.getElementById('shareFacebook').href =
            `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}&quote=${encodeURIComponent(text)}`;
    }

    document.getElementById('shareInstagram').addEventListener('click', async (e) => {
        e.preventDefault();
        const t = TRANSLATIONS[currentLang];
        try {
            await navigator.clipboard.writeText(window.location.href);
            const msg = currentLang === 'az'
                ? 'Link kopyalandı! Instagram-da paylaşa bilərsiniz 📷'
                : currentLang === 'ru'
                ? 'Ссылка скопирована! Можете поделиться в Instagram 📷'
                : 'Link copied! You can share on Instagram 📷';
            showToast(msg);
            window.open('https://www.instagram.com/', '_blank');
        } catch (err) {
            window.open('https://www.instagram.com/', '_blank');
        }
    });

    // ═══════════════════════════════════════════════════════════
    // 🚀 INIT
    // ═══════════════════════════════════════════════════════════
    (function init() {
        // Restore saved language
        let savedLang = 'az';
        try { savedLang = localStorage.getItem('inad-lang') || 'az'; } catch (e) {}
        setLanguage(savedLang);
    })();
    </script>
