            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
            border-radius: 2px;
            transition: all 0.2s ease;
            display: inline-block;
            letter-spacing: 0.3px;
        }

        .btn-primary:hover {
            background: var(--accent-red-dark);
            border-color: var(--accent-red-dark);
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-white);
            border: 1px solid rgba(255, 255, 255, 0.4);
            padding: 14px 28px;
            font-family: inherit;
            font-weight: 500;
            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
            border-radius: 2px;
            transition: all 0.2s ease;
            display: inline-block;
            letter-spacing: 0.3px;
        }

        .btn-secondary:hover {
            border-color: var(--text-white);
            background: rgba(255, 255, 255, 0.05);
        }

        .hero-right {
            position: relative;
        }

        .hero-photo {
            position: relative;
            aspect-ratio: 3 / 4;
            overflow: hidden;
            border-radius: 4px;
            border: 1px solid var(--border-dark);
            background: #2a2a2a;
        }

        .hero-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

        .hero-photo-caption {
            position: absolute;
            bottom: 16px;
            left: 16px;
            background: rgba(0, 0, 0, 0.7);
            color: var(--text-white);
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 2px;
            backdrop-filter: blur(4px);
        }

        /* ═══════════════════════════════════════ */
        /* STATS STRIP                             */
        /* ═══════════════════════════════════════ */
        .stats {
            background: var(--accent-red);
            color: var(--text-white);
            padding: 40px 24px;
        }

        .stats-grid {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
        }

        .stat {
            text-align: center;
            padding: 0 20px;
            border-right: 1px solid rgba(255, 255, 255, 0.2);
        }

        .stat:last-child { border-right: none; }

        .stat-number {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 48px;
            line-height: 1;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            opacity: 0.9;
        }

        /* ═══════════════════════════════════════ */
        /* MOTHER QUOTE                            */
        /* ═══════════════════════════════════════ */
        .mother-quote {
            background: var(--bg-white);
            padding: 80px 40px;
            text-align: center;
        }

        .mother-quote-inner {
            max-width: 760px;
            margin: 0 auto;
            border-left: 3px solid var(--accent-red);
            padding: 12px 0 12px 32px;
            text-align: left;
        }

        .mother-quote-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--accent-red);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
            display: block;
        }

        .mother-quote-text {
            font-family: 'Lora', serif;
            font-size: 26px;
            font-style: italic;
            font-weight: 500;
            line-height: 1.5;
            color: var(--text-dark);
            margin-bottom: 24px;
            letter-spacing: -0.3px;
        }

        .mother-quote-author {
            font-size: 14px;
            color: var(--text-light);
            font-weight: 500;
        }

        /* ═══════════════════════════════════════ */
        /* STORY                                   */
        /* ═══════════════════════════════════════ */
        .story {
            background: var(--bg-cream);
            padding: 80px 40px;
        }

        .story-inner {
            max-width: 880px;
            margin: 0 auto;
        }

        .story-title {
            font-family: 'Lora', serif;
            font-size: 36px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 12px;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

        .story-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 3px;
            background: var(--accent-red);
            margin: 16px auto 48px;
        }

        .story-text {
            column-count: 2;
            column-gap: 40px;
            font-size: 15px;
            line-height: 1.85;
            color: var(--text-dark);
        }

        .story-text p {
            margin-bottom: 18px;
            break-inside: avoid;
        }

        .story-text p:first-child::first-letter {
            font-family: 'Lora', serif;
            font-size: 56px;
            font-weight: 700;
            float: left;
            line-height: 1;
            margin: 4px 8px 0 0;
            color: var(--accent-red);
        }

        /* ═══════════════════════════════════════ */
        /* GALLERY                                 */
        /* ═══════════════════════════════════════ */
        .gallery {
            background: var(--bg-white);
            padding: 80px 40px;
        }

        .gallery-inner { max-width: 1200px; margin: 0 auto; }

        .section-title {
            font-family: 'Lora', serif;
            font-size: 36px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 12px;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 3px;
            background: var(--accent-red);
            margin: 16px auto 48px;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .gallery-item {
            position: relative;
            aspect-ratio: 3 / 4;
            overflow: hidden;
            cursor: pointer;
            border-radius: 4px;
            background: #f0f0f0;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease, filter 0.4s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
            filter: brightness(0.85);
        }

        .gallery-item::after {
            content: '⊕';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: var(--text-white);
            font-size: 32px;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        }

        .gallery-item:hover::after { opacity: 1; }

        /* ═══════════════════════════════════════ */
        /* TRANSPARENCY / DOCUMENTS                */
        /* ═══════════════════════════════════════ */
        .transparency {
            background: var(--bg-white);
            padding: 80px 40px;
            border-top: 1px solid var(--border-subtle);
        }

        .transparency-inner { max-width: 1200px; margin: 0 auto; }

        .docs-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-bottom: 48px;
        }

        .doc-card {
            background: var(--bg-cream);
            border: 1px solid var(--border-subtle);
            padding: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: 4px;
        }

        .doc-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border-color: var(--accent-red);
        }

        .doc-thumb {
            aspect-ratio: 3 / 4;
            overflow: hidden;
            margin-bottom: 12px;
            background: #fff;
            border: 1px solid var(--border-subtle);
        }

        .doc-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .doc-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            text-align: center;
            line-height: 1.4;
        }

        .badges-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            max-width: 720px;
            margin: 0 auto;
        }

        .badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg-cream);
            padding: 14px 18px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-dark);
            border-radius: 4px;
            border-left: 3px solid var(--accent-red);
        }

        .badge-check {
            color: var(--accent-red);
            font-weight: 700;
            font-size: 16px;
        }

        /* ═══════════════════════════════════════ */
        /* DONATION                                */
        /* ═══════════════════════════════════════ */
        .donation {
            background: var(--bg-dark);
            color: var(--text-white);
            padding: 80px 40px;
        }

        .donation-inner { max-width: 1100px; margin: 0 auto; text-align: center; }

        .donation-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--accent-red);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
            display: block;
        }

        .donation-title {
            font-family: 'Lora', serif;
            font-size: 36px;
            font-weight: 600;
            margin-bottom: 48px;
            color: var(--text-white);
            letter-spacing: -0.5px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .bank-card {
            background: #2a2a2a;
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 28px 24px;
            border-radius: 4px;
            text-align: left;
            transition: all 0.2s ease;
        }

        .bank-card:hover {
            border-color: var(--accent-red);
            transform: translateY(-2px);
        }

        .bank-name {
            font-size: 12px;
            font-weight: 600;
            color: var(--accent-red);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 16px;
        }

        .card-number {
            font-family: 'IBM Plex Mono', 'Courier New', monospace;
            font-size: 17px;
            font-weight: 600;
            color: var(--text-white);
            letter-spacing: 1px;
            margin-bottom: 20px;
            word-break: break-all;
        }

        .copy-btn {
            background: var(--accent-red);
            color: var(--text-white);
            border: none;
            padding: 10px 18px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 2px;
            transition: all 0.2s ease;
            width: 100%;
            letter-spacing: 0.3px;
        }

        .copy-btn:hover { background: var(--accent-red-dark); }
        .copy-btn.copied { background: #2E7D32; }

        .card-holder {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
            margin-top: 12px;
        }

        /* ═══════════════════════════════════════ */
        /* SHARE                                   */
        /* ═══════════════════════════════════════ */
        .share {
            background: var(--bg-white);
            padding: 80px 40px;
            text-align: center;
        }

        .share-inner { max-width: 760px; margin: 0 auto; }

        .share-title {
            font-family: 'Lora', serif;
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

        .share-subtitle {
            font-size: 16px;
            color: var(--text-light);
            margin-bottom: 36px;
        }

        .share-buttons {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .share-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 26px;
            color: var(--text-white);
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            border-radius: 2px;
            transition: all 0.2s ease;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }

        .share-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
