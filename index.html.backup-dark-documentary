        .nav-logo {
            font-family: 'Lora', serif;
            font-size: 22px;
            font-weight: 600;
            font-style: italic;
            letter-spacing: -0.3px;
            color: var(--text-white);
            text-decoration: none;
        }

        .nav-logo span { color: var(--accent-red); }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .lang-switcher {
            display: flex;
            gap: 4px;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .lang-btn {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.5);
            padding: 6px 10px;
            cursor: pointer;
            transition: color 0.2s ease;
            font-family: inherit;
            text-transform: uppercase;
            font-size: 12px;
        }

        .lang-btn:hover { color: var(--text-white); }
        .lang-btn.active { color: var(--text-white); border-bottom: 1px solid var(--accent-red); }

        .nav-cta {
            background: var(--accent-red);
            color: var(--text-white);
            border: none;
            padding: 10px 20px;
            font-family: inherit;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            border-radius: 2px;
            transition: background 0.2s ease;
            letter-spacing: 0.3px;
        }

        .nav-cta:hover { background: var(--accent-red-dark); }

        .nav-hamburger {
            display: none;
            background: none;
            border: none;
            color: var(--text-white);
            font-size: 24px;
            cursor: pointer;
            padding: 4px 8px;
        }

        /* ═══════════════════════════════════════ */
        /* HERO                                    */
        /* ═══════════════════════════════════════ */
